@@ -68,6 +71,7 @@ typedef enum {
 
 #define SEGMENT_LIST_FLAG_CACHE 1
 #define SEGMENT_LIST_FLAG_LIVE  2
+#define SEGMENT_LIST_FLAG_DELETE 4 ///< XC compat: delete segments that left the list
 
 typedef struct SegmentContext {
     const AVClass *class;  /**< Class for private options. */
@@ -128,8 +132,34 @@ typedef struct SegmentContext {
     SegmentListEntry cur_entry;
     SegmentListEntry *segment_list_entries;
     SegmentListEntry *segment_list_entries_end;
+    char *pending_delete;  ///< XC compat: dropped segment, deleted one segment later
 } SegmentContext;
 
+/* XC compat (+delete): full path of a list entry = directory of the output
+ * template + entry basename (minus any entry prefix). */
+static char *seg_entry_path(AVFormatContext *s, SegmentContext *seg, const char *name)
+{
+    char *dir = av_strdup(s->url), *path;
+    size_t plen = seg->entry_prefix ? strlen(seg->entry_prefix) : 0;
+    if (!dir)
+        return NULL;
+    if (plen && !strncmp(name, seg->entry_prefix, plen))
+        name += plen;
+    path = av_asprintf("%s/%s", av_dirname(dir), name);
+    av_free(dir);
+    return path;
+}
+
+static void seg_delete_pending(AVFormatContext *s, SegmentContext *seg)
+{
+    if (!seg->pending_delete)
+        return;
+    if (unlink(seg->pending_delete) < 0 && errno != ENOENT)
+        av_log(s, AV_LOG_WARNING, "failed to delete old segment %s: %s\n",
+               seg->pending_delete, strerror(errno));
+    av_freep(&seg->pending_delete);
+}
+
