                 seg->segment_list_entries = seg->segment_list_entries->next;
+                if (seg->list_flags & SEGMENT_LIST_FLAG_DELETE) {
+                    /* delete the segment dropped LAST time; keep this one one
+                     * more cycle for players that just fetched the list */
+                    seg_delete_pending(s, seg);
+                    seg->pending_delete = seg_entry_path(s, seg, entry->filename);
+                }
